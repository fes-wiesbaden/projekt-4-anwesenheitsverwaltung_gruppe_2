# PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/attendancemanagementdb
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=change-this-database-password

# JWT signing key: use a random value of at least 32 bytes
APP_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes

# Initial administrator account (change both values outside local development)
SPRING_SECURITY_USER=admin
SPRING_SECURITY_PASSWORD=change-this-admin-password

# Mosquitto broker; use separate credentials for the server and ESP32 reader
MQTT_BROKER_URL=tcp://localhost:1883
MQTT_USERNAME=attendance-backend
MQTT_PASSWORD=change-this-mqtt-password

# Comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# School-local attendance settings
ATTENDANCE_TIME_ZONE=Europe/Berlin
ATTENDANCE_SCHEDULER_DELAY_MS=15000
ATTENDANCE_LATE_GRACE_MINUTES=5
MQTT_RECONNECT_DELAY_MS=5000

# Keep schema updates enabled only for local development.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
