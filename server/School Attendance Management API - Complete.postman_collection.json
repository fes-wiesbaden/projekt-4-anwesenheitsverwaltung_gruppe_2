          "name": "Get RFID enrollment status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rfid/set/status/{{rfidRequestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rfid",
                "set",
                "status",
                "{{rfidRequestId}}"
              ]
            },
            "description": "ADMIN only. Poll this after scanning the chip on the ESP32. Expect PENDING, SAVED, DUPLICATE, INVALID, TIMEOUT or FAILED.; 404 means requestId is unknown/expired."
          },
          "response": []
        },
