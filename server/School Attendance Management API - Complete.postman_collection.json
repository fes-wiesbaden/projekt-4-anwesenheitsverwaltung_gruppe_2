            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.requestId) pm.environment.set(\"rfidRequestId\", data.requestId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rfid/set",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rfid",
                "set"
              ]
            },
            "description": "ADMIN only. Sends enrollment request to MQTT topic attendance/server/setRfid. Response normally 202 {requestId,status:\"PENDING\"}; requestId saved to rfidRequestId. The ESP32 must publish the captured UID to attendance/reader/set. This endpoint does not take a request body."
          },
          "response": []
        },
