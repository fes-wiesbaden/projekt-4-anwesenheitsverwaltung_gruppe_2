    {
      "name": "05 - Timetable",
      "item": [
        {
          "name": "Get classroom timetable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classroom/{{classroomId}}/timetable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classroom",
                "{{classroomId}}",
                "timetable"
              ]
            },
            "description": "Authenticated. ADMIN or a teacher with access to this classroom. Returns configured weekday entries."
          },
          "response": []
        },
        {
          "name": "Set or update weekday timetable",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startTime\": \"08:00:00\",\n  \"checkoutTime\": \"14:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/classroom/{{classroomId}}/timetable/{{timetableDay}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classroom",
                "{{classroomId}}",
                "timetable",
                "{{timetableDay}}"
              ]
            },
            "description": "ADMIN only. timetableDay must be MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY or SUNDAY. Times are LocalTime strings HH:mm:ss; checkoutTime must be later than startTime."
          },
          "response": []
        },
        {
          "name": "Delete weekday timetable",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classroom/{{classroomId}}/timetable/{{timetableDay}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classroom",
                "{{classroomId}}",
                "timetable",
                "{{timetableDay}}"
              ]
            },
            "description": "ADMIN only. Returns 204. Can return 409 if deleting this timetable entry is blocked by related session history."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Attendance",
      "item": [
        {
          "name": "Manual check-in student (ADMIN only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/attendance/checkin/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "checkin",
                "{{studentId}}"
              ]
            },
            "description": "ADMIN only manual check-in API. Normal RFID card scans are processed by MQTT, not by this HTTP endpoint. Requires the student to belong to a class with an active timetable session."
          },
          "response": []
        },
        {
          "name": "Get attendance history by student (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "student",
                "{{studentId}}"
              ]
            },
            "description": "Authenticated. ADMIN can read any student; TEACHER only students in an accessible classroom. This endpoint returns attendance records."
          },
          "response": []
        },
        {
          "name": "Get attendance history by student (legacy POST)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "student",
                "{{studentId}}"
              ]
            },
            "description": "Legacy compatibility route: POST performs the same read as GET and does not require a request body. Prefer the GET request."
          },
          "response": []
        },
        {
          "name": "Release one student early",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/student/{{studentId}}/checkout?reason=Parent pickup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "student",
                "{{studentId}}",
                "checkout"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}",
                  "description": "Optional ISO date; defaults to school-local today",
                  "disabled": true
                },
                {
                  "key": "reason",
                  "value": "Parent pickup",
                  "description": "Optional release reason"
                }
              ]
            },
            "description": "Authenticated; ADMIN or teacher with access to the student classroom. Releases a checked-in student from the active session. Optional date defaults to school-local today; reason is recorded in the attendance description and audit trail."
          },
          "response": []
        },
        {
          "name": "Release entire class early",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/class/{{classroomId}}/checkout?reason=Class dismissed early",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "class",
                "{{classroomId}}",
                "checkout"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}",
                  "description": "Optional ISO date; defaults to school-local today",
                  "disabled": true
                },
                {
                  "key": "reason",
                  "value": "Class dismissed early",
                  "description": "Optional release reason"
                }
              ]
            },
            "description": "Authenticated; ADMIN or teacher with access to classroom. Checks out all checked-in students and closes the session. Also closes the session if nobody checked in. Optional date defaults to school-local today."
          },
          "response": []
        },
        {
          "name": "Get classroom attendance session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data && data.id !== undefined) pm.environment.set(\"sessionId\", data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/class/{{classroomId}}/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "class",
                "{{classroomId}}",
                "session"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}",
                  "description": "Optional ISO date; defaults to school-local today",
                  "disabled": true
                }
              ]
            },
            "description": "Authenticated; ADMIN or teacher with access to classroom. Returns 404 if no session has been created for the selected date. The scheduler creates the session when timetable start is reached; RFID scan can also create it at/after start while the session is active."
          },
          "response": []
        },
        {
          "name": "Get session attendance roster",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/class/{{classroomId}}/session/attendance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "class",
                "{{classroomId}}",
                "session",
                "attendance"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{today}}",
                  "description": "Optional ISO date; defaults to school-local today",
                  "disabled": true
                }
              ]
            },
            "description": "Authenticated; ADMIN or teacher with access to classroom. Returns roster rows for the session, including seeded ABSENT records and attendance/check-out details."
          },
          "response": []
        },
        {
          "name": "Get session audit history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/attendance/session/{{sessionId}}/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "attendance",
                "session",
                "{{sessionId}}",
                "audit"
              ]
            },
            "description": "Authenticated; ADMIN or teacher with access to the session classroom. Returns audit events such as RFID check-in, manual check-in, early release and automatic timetable-end checkout."
          },
          "response": []
        }
      ]
    },
